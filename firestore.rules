rules_version = '2';

// ─── MediDemo Firestore Security Rules ──────────────────────────
// Copy these rules into Firebase Console → Firestore Database → Rules tab
// Then click "Publish".

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Public-read catalog (active items only) ───────────────
    // Anyone can read active items; only admins can write.
    match /products/{id} {
      allow read: if resource.data.status == 'active' || isAdmin();
      allow write: if isAdmin();
    }
    match /categories/{id} {
      allow read: if resource.data.visibility == 'active' || isAdmin();
      allow write: if isAdmin();
    }
    match /brands/{id} {
      allow read: if resource.data.visibility == 'active' || isAdmin();
      allow write: if isAdmin();
    }
    match /offers/{id} {
      allow read: if resource.data.visibility == 'active' || isAdmin();
      allow write: if isAdmin();
    }
    match /banners/{id} {
      allow read: if resource.data.visibility == 'active' || isAdmin();
      allow write: if isAdmin();
    }
    match /lab_packages/{id} {
      allow read: if resource.data.visibility == 'active' || isAdmin();
      allow write: if isAdmin();
    }
    match /lab_tests/{id} {
      allow read: if resource.data.visibility == 'active' || isAdmin();
      allow write: if isAdmin();
    }
    match /health_concerns/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Users: each user can read/update their own record ─────
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // ─── Orders: customers create & read their own; admins all ─
    match /orders/{orderId} {
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        resource.data.customerEmail == request.auth.token.email ||
        isAdmin()
      );
      allow create: if request.auth != null;
      allow update, delete: if isAdmin();
    }

    // ─── Transactions: admin-only ──────────────────────────────
    match /transactions/{id} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ─── Employees: admin-only ─────────────────────────────────
    match /employees/{id} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ─── Support tickets: customers create & read their own ────
    match /support_tickets/{id} {
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow create: if request.auth != null;
      allow update, delete: if isAdmin();
    }

    // ─── Helper function: admin role check ────────────────────
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.role == 'admin' ||
        request.auth.token.role == 'manager'
      );
    }
  }
}
